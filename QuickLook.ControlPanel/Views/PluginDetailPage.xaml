<Page
    x:Class="QuickLook.ControlPanel.Views.PluginDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="20,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Link" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    <TextBlock x:Name="UrlDisplay" 
                               Text="正在加载地址..." 
                               IsTextSelectionEnabled="True" 
                               VerticalAlignment="Center" 
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" 
                               FontWeight="SemiBold" 
                               FontSize="14" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="DownloadBtn" Click="DownloadButton_Click" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Download" />
                            <TextBlock Text="下载插件" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenBrowserBtn" Click="OpenInBrowser_Click" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="World" />
                            <TextBlock Text="在浏览器中打开" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <WebView2 x:Name="RepoWebView" Grid.Row="1" Visibility="Visible" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        
        <StackPanel x:Name="LoadingArea" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ProgressRing x:Name="LoadingRing" IsActive="True" Width="60" Height="60" Margin="0,0,0,10" />
            <TextBlock x:Name="LoadingStatus" Text="正在加载详情..." HorizontalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" />
        </StackPanel>
    </Grid>
</Page>
