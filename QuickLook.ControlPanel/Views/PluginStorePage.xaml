<Page
    x:Class="QuickLook.ControlPanel.Views.PluginStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:QuickLook.ControlPanel.Services"
    mc:Ignorable="d">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="插件商店" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,24" />

        <Grid Grid.Row="1">
            <GridView x:Name="PluginsGridView" Padding="0,0,0,32">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="services:StorePluginInfo">
                        <Grid Width="280" Height="180" Margin="8" Padding="16" 
                              Background="{ThemeResource LayerFillColorDefaultBrush}" 
                              BorderThickness="1" 
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              CornerRadius="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Introduction Area (Clickable) -->
                            <Button Grid.Row="0" 
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DetailButton_Click"
                                    Tag="{x:Bind RepositoryUrl}">
                                <Grid Padding="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                                        <SymbolIcon Symbol="Shop" Width="32" Height="32" />
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Width="180" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3" />
                                </Grid>
                            </Button>

                            <Grid Grid.Row="1" Margin="16,0,16,16">
                                <TextBlock Text="{x:Bind LastUpdate}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Button Content="下载" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="DownloadButton_Click" Tag="{x:Bind DownloadUrl}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ProgressRing x:Name="LoadingRing" IsActive="True" Width="60" Height="60" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
            
            <StackPanel x:Name="ErrorArea" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
                <SymbolIcon Symbol="Refresh" Width="48" Height="48" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <TextBlock Text="无法加载插件列表，请检查网络连接。" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center" />
                <Button Content="重试" HorizontalAlignment="Center" Click="RetryButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
