<Window x:Class="WpfWebView2Nav.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfWebView2Nav"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        Title="WPF WebView2 Navigation" Height="600" Width="1000"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:Design.RequestedTheme="Dark"
        Background="Transparent">
    
    <Grid>
        <ui:NavigationView x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsSettingsVisible="True"
                           Background="Transparent"
                           SelectionChanged="RootNavigation_SelectionChanged">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="必应 (Bing)" 
                                        Tag="bing">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="World" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="插件商店" 
                                        Tag="plugins">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Shop" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="项目详情" 
                                        Tag="details">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Help" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <Grid Background="Transparent">
                <!-- 必应页面 -->
                <wv2:WebView2 x:Name="webView" Visibility="Visible" DefaultBackgroundColor="Transparent" />
                
                <!-- 插件商店三栏布局 (列表 + 详情) -->
                <Grid x:Name="PluginStoreRoot" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" /> <!-- 中间列表栏 -->
                        <ColumnDefinition Width="*" />   <!-- 右侧详情栏 -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- 中间列表 -->
                    <Border Grid.Column="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0" Background="Transparent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="插件列表" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                <ProgressBar x:Name="LoadingBar" Grid.Column="1" Width="60" Height="4" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                            
                            <ListView x:Name="PluginListView" Grid.Row="1" 
                                      SelectionChanged="PluginListView_SelectionChanged"
                                      BorderThickness="0" Background="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.CanContentScroll="False"
                                      VirtualizingStackPanel.IsVirtualizing="True">
                                <ListView.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                        <Setter Property="ui:ControlHelper.CornerRadius" Value="4" />
                                    </Style>
                                </ListView.Resources>
                                <ListView.Template>
                                    <ControlTemplate TargetType="ListView">
                                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent">
                                            <ScrollViewer x:Name="ScrollViewer" Padding="{TemplateBinding Padding}" 
                                                          Focusable="False"
                                                          IsDeferredScrollingEnabled="False"
                                                          PanningMode="Both">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </ListView.Template>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="Padding" Value="16,12" />
                                        <Setter Property="Margin" Value="0,0,0,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                            <TextBlock Text="{Binding LastUpdate}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    
                    <!-- 右侧详情 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Command Bar -->
                        <ui:CommandBar Grid.Row="0" Background="Transparent" HorizontalAlignment="Left" Margin="8,4">
                            <ui:AppBarToggleButton x:Name="ShowReadmeButton" Icon="Document" Label="显示Readme" IsChecked="True" Click="ShowReadmeButton_Click" />
                            <ui:AppBarToggleButton x:Name="ShowFullPageButton" Icon="World" Label="显示完整网页" Click="ShowFullPageButton_Click" />
                            <ui:AppBarSeparator />
                            <ui:AppBarButton x:Name="OpenInBrowserButton" Icon="OpenWith" Label="在浏览器中打开" Click="OpenInBrowserButton_Click" />
                        </ui:CommandBar>

                        <Grid Grid.Row="1">
                            <wv2:WebView2 x:Name="detailWebView" Visibility="Collapsed" DefaultBackgroundColor="Transparent" NavigationCompleted="detailWebView_NavigationCompleted" />
                            <StackPanel x:Name="DetailPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Library" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Text="从左侧选择插件查看详情" Margin="0,16,0,0" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </ui:NavigationView>
    </Grid>
</Window>